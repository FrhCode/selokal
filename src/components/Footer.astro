---
const columns = [
  {
    title: 'JELAJAHI',
    links: [
      { label: 'Menu', href: '/menu' },
      { label: 'Layanan', href: '/under-development' },
      { label: 'Cerita', href: '/under-development' },
      { label: 'Jurnal', href: '/jurnal' },
    ],
  },
  {
    title: 'BANTUAN',
    links: [
      { label: 'FAQ', href: '/#faq' },
      { label: 'Kebijakan privasi', href: '/under-development' },
      { label: 'Syarat & ketentuan', href: '/under-development' },
      { label: 'Karier', href: '/under-development' },
    ],
  },
  {
    title: 'HUBUNGI',
    links: [
      { label: 'halo@selokal.id', href: 'mailto:halo@selokal.id' },
      { label: '+62 812 3456 7890', href: 'tel:+6281234567890' },
      { label: 'Instagram', href: 'https://instagram.com' },
      { label: 'TikTok', href: 'https://tiktok.com' },
    ],
  },
  {
    title: 'DAPUR',
    links: [
      { label: 'Jl. Kemang Selatan 12', href: '/under-development' },
      { label: 'Jakarta Selatan', href: '/under-development' },
      { label: 'Senin–Sabtu, 08.00–18.00', href: '/under-development' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="foot-wordmark" aria-hidden="true">SELOKAL</div>

    <div class="foot-cols">
      {
        columns.map((column) => (
          <div class="foot-col">
            <h2 class="eyebrow muted">{column.title}</h2>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="foot-bottom">
    <div class="container foot-bottom-inner">
      <p class="foot-social eyebrow">Instagram&ensp;&ensp;TikTok&ensp;&ensp;Pinterest</p>
      <div class="foot-meta">
        <p class="t-caption">© 2026 Selokal. Seluruh hak cipta.</p>
        <p class="foot-legal t-caption">
          <a href="/under-development">Kebijakan Privasi</a>
          <a href="/under-development">Syarat &amp; Ketentuan</a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--white);
    border-top: 1px solid var(--hairline);
  }

  .foot-wordmark {
    padding-top: 34px;
    font-size: clamp(48px, 9.72vw, 140px);
    font-weight: 200;
    line-height: 1;
    letter-spacing: 0.22em;
    color: var(--red);
    white-space: nowrap;
  }

  .foot-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    padding-block: 72px 64px;
  }

  .foot-col h2 {
    margin-bottom: 20px;
    font-weight: 500;
  }

  .foot-col ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .foot-col a {
    font-size: 15px;
    line-height: 1.5;
    transition: color var(--dur) var(--ease);
  }

  .foot-col a:hover {
    color: var(--red);
  }

  .foot-bottom {
    background: var(--sand);
  }

  .foot-bottom-inner {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-block: 34px;
  }

  .foot-social {
    color: var(--ink);
  }

  .foot-meta {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    color: var(--muted);
  }

  .foot-legal {
    display: flex;
    gap: 28px;
    justify-content: center;
  }

  .foot-legal a {
    transition: color var(--dur) var(--ease);
  }

  .foot-legal a:hover {
    color: var(--red);
  }

  @media (max-width: 900px) {
    .foot-cols {
      grid-template-columns: repeat(2, 1fr);
      padding-block: 56px 48px;
    }

    .foot-meta {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .foot-legal {
      justify-content: flex-start;
    }
  }

  @media (max-width: 480px) {
    .foot-cols {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
