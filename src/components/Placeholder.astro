---
import Arrow from '../components/Arrow.astro';

interface Props {
  eyebrow: string;
  lines: string[];
  body: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
}

const {
  eyebrow,
  lines,
  body,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="placeholder">
  <div class="container placeholder-inner">
    <span class="placeholder-rule" aria-hidden="true"></span>
    <p class="eyebrow placeholder-eyebrow">{eyebrow}</p>
    <h1 class="placeholder-title">
      {lines.map((line, index) => (
        <>{index > 0 && <br />}{line}</>
      ))}
    </h1>
    <p class="placeholder-body">{body}</p>
    <div class="placeholder-actions">
      <a class="btn btn--lg" href={primaryHref}>{primaryLabel}</a>
      <a class="arrow-link" href={secondaryHref}>
        {secondaryLabel}
        <Arrow />
      </a>
    </div>
  </div>
</section>

<style>
  .placeholder {
    background: var(--cream);
    padding-block: 56px 104px;
  }

  .placeholder-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .placeholder-rule {
    width: 48px;
    height: 3px;
    background: var(--red);
  }

  .placeholder-eyebrow {
    margin-top: 24px;
    color: var(--red);
  }

  .placeholder-title {
    max-width: 900px;
    margin-top: 28px;
    font-size: clamp(48px, 5.56vw, 80px);
    font-weight: 200;
    line-height: 1.05;
    letter-spacing: -0.015em;
  }

  .placeholder-body {
    max-width: 520px;
    margin-top: 28px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }

  .placeholder-actions {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-top: 40px;
  }

  .placeholder-actions .btn {
    min-width: 248px;
  }

  @media (max-width: 640px) {
    .placeholder {
      padding-block: 40px 72px;
    }

    .placeholder-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .placeholder-actions .btn {
      min-width: 0;
    }
  }
</style>
