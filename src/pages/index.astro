---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-buffet.jpg';
import nasgorImage from '../assets/images/nasgor.jpg';
import spreadImage from '../assets/images/spread.jpg';
import bowlsImage from '../assets/images/bowls.jpg';
import cuttingImage from '../assets/images/cutting.jpg';

const services = [
  {
    name: 'Jamuan kantor',
    body: 'Makan siang tim, rapat panjang, atau perayaan kecil di kantor.',
    image: nasgorImage,
    alt: 'Nasi goreng dengan telur dan sambal di meja kayu',
  },
  {
    name: 'Perayaan keluarga',
    body: 'Akhir pekan bersama keluarga besar, dari 20 hingga 200 tamu.',
    image: spreadImage,
    alt: 'Hidangan Nusantara berjajar di atas meja panjang',
  },
  {
    name: 'Makan malam privat',
    body: 'Menu khusus di rumah Anda, dengan tim yang datang dan merapikan.',
    image: bowlsImage,
    alt: 'Mangkuk-mangkuk kecil berisi lauk Nusantara',
  },
];

const packages = [
  {
    name: 'Rempah',
    price: 'Rp 185.000',
    min: 'Min. 10 tamu',
    items: 'Nasi liwet · Ayam kampung · Sambal bajak · Lalapan',
    href: '/menu#rempah',
    featured: false,
  },
  {
    name: 'Nusantara',
    price: 'Rp 245.000',
    min: 'Min. 20 tamu',
    items: 'Nasi kuning · Rendang · Gado-gado · Sate ayam · Kue tradisional',
    href: '/menu#nusantara',
    featured: true,
  },
  {
    name: 'Santap Besar',
    price: 'Rp 320.000',
    min: 'Min. 50 tamu',
    items: 'Prasmanan 12 lauk · Stasiun sate · Es kelapa · Kudapan manis',
    href: '/menu#santap-besar',
    featured: false,
  },
];

const faqs = [
  {
    question: 'Apakah Anda melayani acara di luar Jakarta?',
    answer:
      'Kami melayani Jabodetabek setiap hari, dan Bandung, Yogyakarta, serta Bali dengan penyesuaian biaya perjalanan.',
  },
  {
    question: 'Berapa jumlah tamu minimum?',
    answer:
      'Paket Rempah mulai dari 10 tamu, Nusantara 20 tamu, dan Santap Besar 50 tamu. Untuk jumlah di bawah minimum, silakan hubungi kami — kami bisa menyesuaikan.',
  },
  {
    question: 'Berapa lama sebelumnya harus memesan?',
    answer:
      'Kami menyarankan pemesanan dua minggu sebelum acara. Untuk periode akhir tahun dan akhir pekan, sebaiknya empat hingga enam minggu sebelumnya.',
  },
  {
    question: 'Apakah menu bisa disesuaikan untuk diet khusus?',
    answer:
      'Bisa. Beri tahu pantangan, alergi, atau kebutuhan diet saat konsultasi — dapur kami menyesuaikan menu tanpa biaya tambahan untuk penyesuaian sederhana.',
  },
  {
    question: 'Apakah Anda menyediakan staf dan peralatan?',
    answer:
      'Ya. Setiap paket sudah termasuk tim, pelayan, peralatan saji, dan pembersihan setelah jamuan.',
  },
  {
    question: 'Bisakah kami menyediakan minuman sendiri?',
    answer:
      'Bisa, dengan biaya corkage yang kami sampaikan saat konsultasi. Kami tetap menyediakan air mineral dan es.',
  },
  {
    question: 'Apakah tersedia layanan cicip menu?',
    answer:
      'Ya, untuk pemesanan di atas 50 tamu. Cicip menu dijadwalkan seminggu sebelum acara dan dihitung sebagai bagian dari paket.',
  },
];
---

<Base
  title="Selokal — Rasa lokal, di meja Anda"
  description="Katering dan jamuan Nusantara di Jakarta. Bahan musiman, bumbu yang diulek pagi hari, dan jamuan yang hangat seperti di rumah."
>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">Katering &amp; jamuan · Jakarta</p>
        <h1 class="t-h1">Rasa lokal,<br />di meja Anda.</h1>
        <p class="t-body-lg hero-body">
          Kami membawa masakan Nusantara ke perayaan Anda — bahan musiman,
          bumbu yang diulek segar, dan jamuan yang hangat seperti di rumah.
        </p>
        <p class="t-body-lg hero-body">
          Dari jamuan kantor hingga perayaan keluarga, kami mengurus makanannya.
          Anda menikmati momennya.
        </p>
        <a class="arrow-link hero-link" href="/menu">
          Lihat paket jamuan
          <Arrow />
        </a>
      </div>

      <div class="hero-seam" aria-hidden="true"></div>

      <div class="hero-media">
        <Image
          src={heroImage}
          alt="Prasmanan Nusantara dengan nasi, lauk, dan lalapan di atas daun pisang"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 900px) 100vw, 46vw"
          loading="eager"
          fetchpriority="high"
        />
        <p class="hero-caption eyebrow">Prasmanan Nusantara — jamuan panjang</p>
      </div>
    </div>
  </section>

  <section class="manifesto">
    <div class="container">
      <span class="red-rule" aria-hidden="true"></span>
      <p class="manifesto-statement t-h3" data-reveal>
        Kami memasak hidangan Nusantara dengan bahan musiman, bumbu yang diulek
        pagi hari, dan jamuan yang hangat seperti di rumah.
      </p>
      <p class="manifesto-note eyebrow muted">Sejak 2019 · Jakarta</p>
    </div>
  </section>

  <section class="services section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="t-h4">Tiga cara untuk berkumpul.</h2>
        <p class="t-body muted section-desc">
          Satu pendekatan: dimasak saksama, disajikan tanpa merepotkan.
        </p>
      </div>

      <ul class="service-list">
        {
          services.map((service, index) => (
            <li data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <a class="service-row" href="/under-development">
                <span class="service-name t-h4">{service.name}</span>
                <span class="service-body t-body muted">{service.body}</span>
                <span class="row-arrow" aria-hidden="true">
                  <Arrow />
                </span>
                <span class="service-media">
                  <Image
                    src={service.image}
                    alt={service.alt}
                    widths={[240, 480]}
                    sizes="(max-width: 900px) 120px, 240px"
                    loading="lazy"
                  />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="packages section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="t-h4">Harga jelas, menu bisa disesuaikan.</h2>
        <p class="t-body muted section-desc">
          Semua harga per tamu. Sudah termasuk tim, peralatan saji, dan
          koordinasi sebelum hari acara.
        </p>
      </div>

      <ul class="package-list">
        {
          packages.map((pack, index) => (
            <li
              class:list={['package-row', { 'is-featured': pack.featured }]}
              data-reveal
              style={`--reveal-delay: ${index * 70}ms`}
            >
              <a class="package-link" href={pack.href}>
                <span class="package-name t-h5">{pack.name}</span>
                <span class="package-price">{pack.price}</span>
                <span class="package-min t-small muted">{pack.min}</span>
                <span class="package-items t-small">{pack.items}</span>
                <span class="row-arrow" aria-hidden="true">
                  <Arrow />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="story">
    <div class="story-inner">
      <div class="story-media">
        <Image
          src={cuttingImage}
          alt="Tangan memotong bahan segar di dapur Selokal"
          widths={[480, 720, 1080, 1440]}
          sizes="(max-width: 900px) 100vw, 720px"
          loading="lazy"
        />
      </div>
      <div class="story-copy" data-reveal>
        <h2 class="t-h3">
          Dimasak pagi hari acara, dengan bumbu yang diulek di dapur kami.
        </h2>
        <p class="t-body-lg story-body">
          Kami memasak dalam jumlah kecil, dengan bahan yang baru datang dari
          pasar pagi itu. Tidak ada jalan pintas — hanya waktu, api, dan bumbu
          yang diulek dengan tangan.
        </p>
        <span class="red-rule" aria-hidden="true"></span>
        <ol class="steps">
          <li>Konsultasi</li>
          <li aria-hidden="true" class="step-arrow"><Arrow /></li>
          <li>Rancang menu</li>
          <li aria-hidden="true" class="step-arrow"><Arrow /></li>
          <li>Hari acara</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="testimonial">
    <div class="container testimonial-inner" data-reveal>
      <p class="quote-mark" aria-hidden="true">“</p>
      <div>
        <blockquote class="quote-text t-h3">
          Rasanya seperti makan di rumah nenek — cuma pelayanannya jauh lebih
          rapi.
        </blockquote>
        <p class="quote-attr eyebrow muted">
          Rani &amp; Dimas — perayaan keluarga, 80 tamu
        </p>
      </div>
    </div>
  </section>

  <section class="enquiry section" id="tanya">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="t-h4">Ceritakan acara Anda.</h2>
        <p class="t-body section-desc">
          Kami membalas dalam satu hari kerja dengan saran menu dan perkiraan
          biaya. Untuk hal mendesak, hubungi WhatsApp kami.
        </p>
      </div>

      <form id="enquiry-form" class="enquiry-form" data-reveal>
        <div class="field">
          <label class="eyebrow" for="nama">Nama</label>
          <input id="nama" name="nama" type="text" placeholder="Nama lengkap" required />
        </div>

        <div class="field">
          <label class="eyebrow" for="email">Email</label>
          <input id="email" name="email" type="email" placeholder="nama@email.com" required />
        </div>

        <div class="field">
          <label class="eyebrow" for="whatsapp">WhatsApp</label>
          <input id="whatsapp" name="whatsapp" type="tel" placeholder="+62 ..." required />
        </div>

        <div class="field">
          <label class="eyebrow" for="kota">Kota</label>
          <input id="kota" name="kota" type="text" placeholder="Jakarta" required />
        </div>

        <div class="field">
          <label class="eyebrow" for="jenis-acara">Jenis acara</label>
          <div class="select-wrap">
            <select id="jenis-acara" name="jenis_acara" required>
              <option value="" disabled selected>Pilih jenis acara</option>
              <option>Jamuan kantor</option>
              <option>Perayaan keluarga</option>
              <option>Makan malam privat</option>
              <option>Lainnya</option>
            </select>
            <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </div>
        </div>

        <div class="field">
          <label class="eyebrow" for="jumlah-tamu">Jumlah tamu</label>
          <input id="jumlah-tamu" name="jumlah_tamu" type="number" min="1" placeholder="Perkiraan jumlah" required />
        </div>

        <div class="field">
          <label class="eyebrow" for="tanggal">Tanggal acara</label>
          <input id="tanggal" name="tanggal" type="date" required />
        </div>

        <div class="field">
          <label class="eyebrow" for="lokasi">Lokasi acara</label>
          <input id="lokasi" name="lokasi" type="text" placeholder="Alamat atau venue" required />
        </div>

        <div class="field field--wide">
          <label class="eyebrow" for="pesan">Pesan</label>
          <textarea id="pesan" name="pesan" rows="1" placeholder="Ceritakan suasana acara, menu yang dibayangkan, atau kebutuhan khusus tamu Anda."></textarea>
        </div>

        <div class="enquiry-footer">
          <div class="enquiry-actions">
            <label class="consent">
              <input type="checkbox" name="consent" required />
              <span>
                Saya setuju dihubungi melalui email. Data Anda aman bersama kami.{' '}
                <a href="/under-development">Baca kebijakan privasi.</a>
              </span>
            </label>
            <button class="btn btn--lg" type="submit">Kirim pesan</button>
          </div>

          <div class="enquiry-contact t-small muted">
            <p>WhatsApp +62 812 3456 7890 &nbsp;·&nbsp; halo@selokal.id</p>
            <p>Jl. Kemang Selatan 12, Jakarta Selatan</p>
          </div>
        </div>
      </form>
    </div>
  </section>

  <section class="faq section" id="faq">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="t-h4">Yang sering ditanyakan</h2>
        <p class="t-body muted section-desc">
          Tidak menemukan jawaban? Kirim pesan melalui formulir di atas — kami
          senang membantu.
        </p>
      </div>

      <div class="accordion">
        {
          faqs.map((item, index) => (
            <details class="faq-item" open={index === 0} data-reveal>
              <summary>
                <span class="faq-question t-h6">{item.question}</span>
                <span class="faq-sign" aria-hidden="true"></span>
              </summary>
              <div class="faq-answer">
                <p class="t-body muted">{item.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <dialog id="enquiry-dialog" class="dialog" aria-labelledby="dialog-title">
    <div class="dialog-body">
      <button class="dialog-close" type="button" aria-label="Tutup" data-close>×</button>
      <p class="eyebrow dialog-eyebrow">Terima kasih</p>
      <h2 id="dialog-title" class="t-h4">Pesan Anda sudah kami terima.</h2>
      <p class="t-body muted dialog-text">
        Tim kami akan membalas dalam satu hari kerja. Sementara itu, Anda bisa
        menjelajahi paket jamuan kami.
      </p>
      <div class="dialog-actions">
        <a class="btn" href="/menu">Lihat paket jamuan</a>
        <button class="dialog-dismiss" type="button" data-close>Tutup</button>
      </div>
    </div>
  </dialog>
</Base>

<script>
  const initEnquiry = () => {
    const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
    const dialog = document.getElementById('enquiry-dialog') as HTMLDialogElement | null;
    if (!form || !dialog || form.dataset.bound) return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      form.reset();
      dialog.showModal();
    });

    dialog.querySelectorAll<HTMLElement>('[data-close]').forEach((button) => {
      button.addEventListener('click', () => dialog.close());
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  };

  const initAccordion = () => {
    document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach((details) => {
      if (details.dataset.bound) return;
      details.dataset.bound = 'true';

      const summary = details.querySelector('summary');
      const content = details.querySelector<HTMLElement>('.faq-answer');
      if (!summary || !content) return;

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        content.style.overflow = 'hidden';

        if (details.open) {
          content.style.height = `${content.scrollHeight}px`;
          requestAnimationFrame(() => {
            content.style.height = '0px';
          });
          content.addEventListener(
            'transitionend',
            () => {
              details.open = false;
              content.style.height = '';
            },
            { once: true }
          );
        } else {
          details.open = true;
          content.style.height = '0px';
          requestAnimationFrame(() => {
            content.style.height = `${content.scrollHeight}px`;
          });
          content.addEventListener(
            'transitionend',
            () => {
              content.style.height = '';
            },
            { once: true }
          );
        }
      });
    });
  };

  const initHome = () => {
    initEnquiry();
    initAccordion();
  };

  initHome();
  document.addEventListener('astro:page-load', initHome);
</script>

<style>
  .red-rule {
    display: block;
    width: 80px;
    height: 3px;
    background: var(--red);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 476px;
    gap: 48px;
    align-items: start;
    margin-bottom: 56px;
  }

  .section-head h2 {
    max-width: 800px;
  }

  .section-desc {
    padding-top: 8px;
  }

  /* Hero */
  .hero {
    background: var(--ink);
    color: var(--cream);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 54fr 6px 46fr;
    max-width: var(--page-width);
    margin-inline: auto;
    min-height: 748px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 96px var(--margin) 64px;
  }

  .hero-eyebrow {
    color: var(--red-on-dark);
  }

  .hero-copy h1 {
    margin-top: 20px;
    max-width: 680px;
  }

  .hero-body {
    max-width: 560px;
    color: var(--on-dark);
  }

  .hero-copy h1 + .hero-body {
    margin-top: 56px;
  }

  .hero-body + .hero-body {
    margin-top: 24px;
  }

  .hero-link {
    margin-top: auto;
    padding-top: 64px;
    color: var(--cream);
  }

  .hero-seam {
    background: var(--red-on-dark);
  }

  .hero-media {
    position: relative;
    min-height: 100%;
    overflow: hidden;
  }

  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-caption {
    position: absolute;
    right: 24px;
    bottom: 22px;
    left: 24px;
    color: var(--on-dark);
    text-shadow: 0 1px 12px rgb(0 0 0 / 45%);
  }

  /* Manifesto */
  .manifesto {
    background: var(--cream);
    padding-block: 64px;
  }

  .manifesto-statement {
    max-width: 1150px;
    margin-top: 32px;
    margin-bottom: 24px;
  }

  .manifesto-note {
    text-align: right;
  }

  /* Services */
  .services {
    background: var(--white);
  }

  .service-list {
    border-bottom: 1px solid var(--hairline);
  }

  .service-row {
    display: grid;
    grid-template-columns: 430px minmax(0, 1fr) 40px 240px;
    gap: 24px;
    align-items: center;
    min-height: 180px;
    border-top: 1px solid var(--hairline);
    padding-inline: 0;
  }

  .service-name {
    transition: color var(--dur) var(--ease);
  }

  .service-row:hover .service-name {
    color: var(--red);
  }

  .service-body {
    max-width: 380px;
  }

  .row-arrow {
    display: inline-flex;
    color: var(--red);
    transition: transform var(--dur) var(--ease);
  }

  .service-row:hover .row-arrow,
  .package-link:hover .row-arrow {
    transform: translateX(5px);
  }

  .service-media {
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 2;
  }

  .service-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .service-row:hover .service-media :global(img) {
    transform: scale(1.04);
  }

  /* Packages */
  .packages {
    background: var(--sand);
  }

  .package-list {
    border-bottom: 1px solid var(--hairline);
  }

  .package-row {
    position: relative;
    border-top: 1px solid var(--hairline);
  }

  .package-row.is-featured::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -20px;
    width: 3px;
    height: 96px;
    background: var(--red);
    transform: translateY(-50%);
  }

  .package-link {
    display: grid;
    grid-template-columns: 296px 260px 200px minmax(0, 1fr) 40px;
    align-items: center;
    min-height: 140px;
  }

  .package-price {
    font-size: clamp(24px, 2.22vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.019em;
    color: var(--red);
  }

  .package-items {
    line-height: 1.6;
  }

  /* Story */
  .story {
    background: var(--white);
  }

  .story-inner {
    display: grid;
    grid-template-columns: 50% 50%;
    max-width: var(--page-width);
    margin-inline: auto;
    align-items: stretch;
  }

  .story-media {
    overflow: hidden;
  }

  .story-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-copy {
    padding: 120px var(--margin) 96px;
  }

  .story-copy h2 {
    max-width: 592px;
  }

  .story-body {
    max-width: 540px;
    margin-top: 72px;
  }

  .story-copy .red-rule {
    margin-top: 40px;
    margin-bottom: 32px;
  }

  .steps {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 20px;
    line-height: 1.5;
  }

  .step-arrow {
    display: inline-flex;
    color: var(--red);
  }

  /* Testimonial */
  .testimonial {
    background: var(--cream);
    padding-block: 64px;
  }

  .testimonial-inner {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    align-items: start;
  }

  .quote-mark {
    margin-top: -24px;
    font-size: 140px;
    line-height: 1;
    color: var(--red);
  }

  .quote-text {
    max-width: 1000px;
  }

  .quote-attr {
    margin-top: 56px;
  }

  /* Enquiry form */
  .enquiry {
    background: var(--sand);
  }

  .enquiry-form {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px 32px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .field label {
    color: var(--ink);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0 0 12px;
    border: 0;
    border-bottom: 1px solid var(--ink);
    border-radius: 0;
    background: transparent;
    font-size: 16px;
    line-height: 1.5;
